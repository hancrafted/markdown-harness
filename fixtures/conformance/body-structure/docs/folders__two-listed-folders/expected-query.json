{
  "docs/manual/x.md": {
    "command": "query",
    "modules": [
      "frontmatter",
      "body-structure"
    ],
    "path": "docs/manual/x.md",
    "config": "markdown-harness.config.yaml",
    "result": {
      "governance": "governed",
      "path": "docs/manual/x.md",
      "modules": [
        {
          "module": "body-structure",
          "rule": {
            "ruleId": "guides",
            "intent": "A guide is a title and at least two sections, wherever it lives."
          },
          "requirements": {
            "types": [
              "guide"
            ],
            "maxLevel": 2,
            "headings": [
              {
                "purpose": "heading",
                "level": 1
              },
              {
                "purpose": "enumeration",
                "level": 2,
                "minCount": 2
              }
            ]
          }
        },
        {
          "module": "body-structure",
          "rule": {
            "ruleId": "open-template",
            "intent": "A handbook or manual page opens with a title and an Overview, and may nest as deep as it needs."
          },
          "requirements": {
            "headings": [
              {
                "purpose": "heading",
                "level": 1
              },
              {
                "purpose": "heading",
                "level": 2,
                "pattern": "^Overview$",
                "intent": "What the page covers, in a paragraph."
              }
            ]
          }
        }
      ]
    }
  }
}
