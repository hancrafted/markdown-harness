{
  "docs/research/deep/report.md": {
    "command": "query",
    "modules": [
      "frontmatter",
      "body-structure"
    ],
    "path": "docs/research/deep/report.md",
    "config": "markdown-harness.config.yaml",
    "result": {
      "governance": "governed",
      "path": "docs/research/deep/report.md",
      "modules": [
        {
          "module": "body-structure",
          "rule": {
            "ruleId": "guides",
            "intent": "A guide is a title and at least two sections, wherever it lives."
          },
          "requirements": {
            "types": [
              "guide"
            ],
            "maxLevel": 2,
            "headings": [
              {
                "purpose": "heading",
                "level": 1
              },
              {
                "purpose": "enumeration",
                "level": 2,
                "minCount": 2
              }
            ]
          }
        }
      ]
    }
  }
}
