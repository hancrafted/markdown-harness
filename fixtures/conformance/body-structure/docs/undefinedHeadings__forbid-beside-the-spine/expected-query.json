{
  "x.md": {
    "command": "query",
    "modules": [
      "frontmatter",
      "body-structure"
    ],
    "path": "x.md",
    "config": "markdown-harness.config.yaml",
    "result": {
      "governance": "governed",
      "path": "x.md",
      "modules": [
        {
          "module": "body-structure",
          "rule": {
            "ruleId": "guides",
            "intent": "A guide is a title and at least two sections, wherever it lives."
          },
          "requirements": {
            "types": [
              "guide"
            ],
            "maxLevel": 2,
            "headings": [
              {
                "purpose": "heading",
                "level": 1
              },
              {
                "purpose": "enumeration",
                "level": 2,
                "minCount": 2
              }
            ]
          }
        },
        {
          "module": "body-structure",
          "rule": {
            "ruleId": "closed-record",
            "intent": "A decision record has a title and its sections in a fixed order and nothing else, so a reader finds the status and the decision without hunting through extras."
          },
          "requirements": {
            "undefinedHeadings": "forbid",
            "headings": [
              {
                "purpose": "heading",
                "level": 1
              },
              {
                "purpose": "heading",
                "level": 2,
                "pattern": "^Status$",
                "intent": "Proposed, accepted or superseded, with the date."
              },
              {
                "purpose": "heading",
                "level": 2,
                "pattern": "^Decision$",
                "intent": "What was decided and why."
              },
              {
                "purpose": "heading",
                "level": 2,
                "pattern": "^Consequences$",
                "presence": "optional",
                "intent": "What gets easier and what gets harder."
              }
            ]
          }
        }
      ]
    }
  }
}
