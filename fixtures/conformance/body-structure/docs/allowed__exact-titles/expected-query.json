{
  "x.md": {
    "command": "query",
    "modules": [
      "frontmatter",
      "body-structure"
    ],
    "path": "x.md",
    "config": "markdown-harness.config.yaml",
    "result": {
      "governance": "governed",
      "path": "x.md",
      "modules": [
        {
          "module": "body-structure",
          "rule": {
            "ruleId": "guides",
            "intent": "A guide is a title and at least two sections, wherever it lives."
          },
          "requirements": {
            "types": [
              "guide"
            ],
            "maxLevel": 2,
            "headings": [
              {
                "purpose": "heading",
                "level": 1
              },
              {
                "purpose": "enumeration",
                "level": 2,
                "minCount": 2
              }
            ]
          }
        },
        {
          "module": "body-structure",
          "rule": {
            "ruleId": "allowed-titles",
            "intent": "A journal is titled Notes or Journal and holds at least one entry, every one titled Entry."
          },
          "requirements": {
            "headings": [
              {
                "purpose": "heading",
                "level": 1,
                "allowed": [
                  {
                    "title": "Notes",
                    "intent": "A shared journal."
                  },
                  {
                    "title": "Journal"
                  }
                ]
              },
              {
                "purpose": "enumeration",
                "level": 2,
                "minCount": 1,
                "allowed": [
                  {
                    "title": "Entry"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
