{
  "docs/research/anything.md": {
    "command": "query",
    "modules": [
      "frontmatter",
      "body-structure"
    ],
    "path": "docs/research/anything.md",
    "config": "markdown-harness.config.yaml",
    "result": {
      "governance": "governed",
      "path": "docs/research/anything.md",
      "modules": [
        {
          "module": "body-structure",
          "rule": {
            "ruleId": "research-reports",
            "intent": "Research reads the same way every time, so a reviewer can skim it for findings and sources."
          },
          "requirements": {
            "types": [
              "research"
            ],
            "maxLevel": 3,
            "headings": [
              {
                "purpose": "heading",
                "level": 1
              },
              {
                "purpose": "heading",
                "level": 2,
                "pattern": "^Findings$",
                "intent": "What was measured, with numbers."
              },
              {
                "purpose": "enumeration",
                "level": 3,
                "pattern": "^Detail",
                "maxCount": 2,
                "intent": "Supporting detail under Findings, two at most."
              },
              {
                "purpose": "enumeration",
                "level": 2,
                "pattern": "^Source: ",
                "minCount": 1,
                "intent": "One section per source consulted."
              }
            ]
          }
        },
        {
          "module": "body-structure",
          "rule": {
            "ruleId": "research-notes",
            "intent": "A research note is short, so it has one title and at most three sections."
          },
          "requirements": {
            "types": [
              "note",
              "memo",
              "brief"
            ],
            "maxLevel": 2,
            "headings": [
              {
                "purpose": "heading",
                "level": 1
              },
              {
                "purpose": "enumeration",
                "level": 2,
                "maxCount": 3
              }
            ]
          }
        },
        {
          "module": "body-structure",
          "rule": {
            "ruleId": "research-untyped",
            "intent": "A research file whose type names no template here still has exactly one title and nothing beneath it."
          },
          "requirements": {
            "maxLevel": 1,
            "headings": [
              {
                "purpose": "heading",
                "level": 1
              }
            ]
          }
        }
      ]
    }
  },
  "docs/research/scratch.md": {
    "command": "query",
    "modules": [
      "frontmatter",
      "body-structure"
    ],
    "path": "docs/research/scratch.md",
    "config": "markdown-harness.config.yaml",
    "result": {
      "governance": "governed",
      "path": "docs/research/scratch.md",
      "modules": [
        {
          "module": "body-structure",
          "rule": {
            "ruleId": "research-notes",
            "intent": "A research note is short, so it has one title and at most three sections."
          },
          "requirements": {
            "types": [
              "note",
              "memo",
              "brief"
            ],
            "maxLevel": 2,
            "headings": [
              {
                "purpose": "heading",
                "level": 1
              },
              {
                "purpose": "enumeration",
                "level": 2,
                "maxCount": 3
              }
            ]
          }
        },
        {
          "module": "body-structure",
          "rule": {
            "ruleId": "research-untyped",
            "intent": "A research file whose type names no template here still has exactly one title and nothing beneath it."
          },
          "requirements": {
            "maxLevel": 1,
            "headings": [
              {
                "purpose": "heading",
                "level": 1
              }
            ]
          }
        }
      ]
    }
  }
}
