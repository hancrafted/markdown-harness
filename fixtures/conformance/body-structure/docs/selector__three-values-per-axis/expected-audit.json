{
  "command": "audit",
  "modules": [
    "frontmatter",
    "body-structure"
  ],
  "root": ".",
  "config": "markdown-harness.config.yaml",
  "result": {
    "modules": [
      {
        "module": "frontmatter",
        "rules": []
      },
      {
        "module": "body-structure",
        "rules": [
          {
            "rule": {
              "ruleId": "guides",
              "selector": {
                "types": [
                  "guide"
                ]
              },
              "intent": "A guide is a title and at least two sections, wherever it lives."
            },
            "won": 0,
            "shadowed": 0,
            "shadowedBy": [],
            "excluded": 0
          },
          {
            "rule": {
              "ruleId": "triple-plural",
              "selector": {
                "folders": [
                  "docs/tp/one/",
                  "docs/tp/two/",
                  "docs/tp/three/"
                ],
                "fileNames": [
                  "a.md",
                  "b.md",
                  "c.md"
                ],
                "types": [
                  "t1",
                  "t2",
                  "t3"
                ]
              },
              "intent": "Every axis lists three values, so a file is governed only when each axis matches and the match need not be the first listed."
            },
            "won": 5,
            "shadowed": 0,
            "shadowedBy": [],
            "excluded": 0
          }
        ]
      }
    ]
  }
}
