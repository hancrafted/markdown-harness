{
  "x.md": {
    "command": "query",
    "modules": [
      "frontmatter",
      "body-structure"
    ],
    "path": "x.md",
    "config": "markdown-harness.config.yaml",
    "result": {
      "governance": "governed",
      "path": "x.md",
      "modules": [
        {
          "module": "body-structure",
          "rule": {
            "ruleId": "guides",
            "intent": "A guide is a title and at least two sections, wherever it lives."
          },
          "requirements": {
            "types": [
              "guide"
            ],
            "maxLevel": 2,
            "headings": [
              {
                "purpose": "heading",
                "level": 1
              },
              {
                "purpose": "enumeration",
                "level": 2,
                "minCount": 2
              }
            ]
          }
        },
        {
          "module": "body-structure",
          "rule": {
            "ruleId": "adr-contract",
            "intent": "An ADR has a title and six sections in a fixed order: its context is prose, its decisions are numbered anchors each holding a numbered list, its do and dont blocks are numbered lists, and its references are a bulleted list."
          },
          "requirements": {
            "types": [
              "adr"
            ],
            "undefinedHeadings": "forbid",
            "headings": [
              {
                "purpose": "heading",
                "level": 1
              },
              {
                "purpose": "heading",
                "level": 2,
                "pattern": "^Context$",
                "mayHold": [
                  "prose"
                ]
              },
              {
                "purpose": "heading",
                "level": 2,
                "pattern": "^Decision$"
              },
              {
                "purpose": "enumeration",
                "level": 3,
                "pattern": "^[0-9]+\\. ",
                "minCount": 1,
                "mayHold": [
                  "ordered-list"
                ]
              },
              {
                "purpose": "heading",
                "level": 2,
                "pattern": "^Do's and Don'ts$"
              },
              {
                "purpose": "heading",
                "level": 3,
                "pattern": "^Do's$",
                "mayHold": [
                  "ordered-list"
                ]
              },
              {
                "purpose": "heading",
                "level": 3,
                "pattern": "^Don'ts$",
                "mayHold": [
                  "ordered-list"
                ]
              },
              {
                "purpose": "heading",
                "level": 2,
                "pattern": "^Consequences$",
                "mayHold": [
                  "prose",
                  "ordered-list"
                ]
              },
              {
                "purpose": "heading",
                "level": 2,
                "pattern": "^Compliance and Enforcement$",
                "mayHold": [
                  "prose",
                  "ordered-list"
                ]
              },
              {
                "purpose": "heading",
                "level": 2,
                "pattern": "^References$",
                "mayHold": [
                  "unordered-list"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
