[
  {
    "name": "both Modules claim an absent path",
    "args": ["query", "--batch", "docs/sealed/new.md"],
    "code": 0,
    "stderr": "",
    "stdout": {
      "command": "query",
      "batch": true,
      "modules": ["frontmatter", "body-structure"],
      "paths": ["docs/sealed/new.md"],
      "config": "markdown-harness.config.yaml",
      "result": {
        "results": [
          {
            "governance": "governed",
            "path": "docs/sealed/new.md",
            "modules": [
              {
                "module": "frontmatter",
                "rule": { "ruleId": "sealed", "intent": "A sealed page carries no frontmatter at all." },
                "requirements": { "frontmatter": "forbidden" }
              },
              {
                "module": "body-structure",
                "rule": { "ruleId": "sealed-title", "intent": "A sealed page has exactly one title." },
                "requirements": { "types": ["sealed"], "headings": [{ "purpose": "heading", "level": 1 }] }
              }
            ]
          }
        ]
      }
    }
  },
  {
