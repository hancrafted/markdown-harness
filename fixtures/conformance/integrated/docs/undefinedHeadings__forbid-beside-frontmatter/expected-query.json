{
  "docs/closed/new.md": {
    "command": "query",
    "modules": [
      "frontmatter",
      "body-structure"
    ],
    "path": "docs/closed/new.md",
    "config": "markdown-harness.config.yaml",
    "result": {
      "governance": "governed",
      "path": "docs/closed/new.md",
      "modules": [
        {
          "module": "frontmatter",
          "rule": {
            "ruleId": "closed",
            "intent": "A closed note says what it is about."
          },
          "requirements": {
            "fields": [
              {
                "field": "description",
                "presence": "required"
              }
            ]
          }
        },
        {
          "module": "body-structure",
          "rule": {
            "ruleId": "closed-notes",
            "intent": "A closed note has one title and no other heading, whatever its frontmatter does."
          },
          "requirements": {
            "undefinedHeadings": "forbid",
            "headings": [
              {
                "purpose": "heading",
                "level": 1
              }
            ]
          }
        }
      ]
    }
  }
}
