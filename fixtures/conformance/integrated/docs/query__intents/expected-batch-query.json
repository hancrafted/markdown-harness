[
  {
    "name": "a governed path keeps only the Steering content",
    "args": [
      "query",
      "--intents",
      "docs/notes/new.md"
    ],
    "code": 0,
    "stderr": "",
    "stdout": {
      "command": "query",
      "intents": true,
      "modules": [
        "frontmatter",
        "body-structure"
      ],
      "path": "docs/notes/new.md",
      "config": "markdown-harness.config.yaml",
      "result": {
        "governance": "governed",
        "path": "docs/notes/new.md",
        "modules": [
          {
            "module": "frontmatter",
            "rule": {
              "ruleId": "note",
              "intent": "Every note says what it is."
            },
            "requirements": {
              "fields": [
                {
                  "field": "type",
                  "presence": "required",
                  "intent": "The kind of note, so a reader can pick one without opening it.",
                  "allowed": [
                    {
                      "value": "decision",
                      "intent": "A choice made, with the reason."
                    }
                  ]
                }
              ]
            }
          },
          {
            "module": "body-structure",
            "rule": {
              "ruleId": "note-shape",
              "intent": "A note opens with a title and says why it exists."
            },
            "requirements": {
              "headings": [
                {
                  "level": 1,
                  "presence": "required",
                  "intent": "The note names its subject here."
                },
                {
                  "level": 2,
                  "presence": "optional",
                  "allowed": [
                    {
                      "title": "Outcome",
                      "intent": "What was decided."
                    }
                  ],
                  "headings": [
                    {
                      "level": 3,
                      "pattern": "^Why$",
                      "intent": "The reason, in one paragraph."
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  },
