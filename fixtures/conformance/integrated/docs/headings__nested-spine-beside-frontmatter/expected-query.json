{
  "docs/titles/new.md": {
    "command": "query",
    "modules": [
      "frontmatter",
      "body-structure"
    ],
    "path": "docs/titles/new.md",
    "config": "markdown-harness.config.yaml",
    "result": {
      "governance": "governed",
      "path": "docs/titles/new.md",
      "modules": [
        {
          "module": "frontmatter",
          "rule": {
            "ruleId": "titles",
            "intent": "A note says what it is about."
          },
          "requirements": {
            "fields": [
              {
                "field": "description",
                "presence": "required"
              }
            ]
          }
        },
        {
          "module": "body-structure",
          "rule": {
            "ruleId": "titles-notes",
            "intent": "A note has a title and a prose summary, and the headings under the summary come from a short fixed set."
          },
          "requirements": {
            "undefinedHeadings": "forbid",
            "headings": [
              {
                "purpose": "heading",
                "level": 1
              },
              {
                "purpose": "heading",
                "level": 2,
                "pattern": "^Summary$",
                "mayHold": [
                  "prose"
                ],
                "headings": [
                  {
                    "purpose": "enumeration",
                    "level": 3,
                    "minCount": 0,
                    "allowed": [
                      {
                        "title": "Added",
                        "intent": "What the note adds."
                      },
                      {
                        "title": "Fixed"
                      }
                    ],
                    "mayHold": [
                      "unordered-list"
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
