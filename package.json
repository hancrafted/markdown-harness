{
  "name": "markdown-harness",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:boundaries": "depcruise src",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "knip": "knip",
    "prepare": "husky",
    "verify": "archgate check && eslint . && prettier --check . && tsc --noEmit && npm run lint:boundaries && vitest run && knip",
    "verify:commit": "lint-staged && archgate check && tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@types/node": "~26.3.0",
    "@vitest/coverage-v8": "~4.1.11",
    "archgate": "~0.55.0",
    "dependency-cruiser": "~18.2.0",
    "eslint": "~10.9.1",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-check-file": "~3.3.2",
    "husky": "~9.1.7",
    "knip": "~6.32.2",
    "lint-staged": "~17.3.0",
    "prettier": "~3.9.6",
    "prettier-plugin-organize-imports": "~4.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.68.0",
    "vitest": "~4.1.11",
    "yaml": "~2.9.0"
  }
}
